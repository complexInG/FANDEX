---
/**
 * 学习路线图页面
 * -----------------------------------------------------------------------------
 * 展示两块内容：
 * 1. 职业学习路径选择区（Tab 切换 + 动态详情渲染）
 * 2. 学习阶段时间线（按阶段循序渐进的模块卡片）
 *
 * 样式与交互逻辑已拆分至独立文件：
 * - styles/pages/roadmap.css     页面级样式
 * - lib/roadmap-interactions.ts  客户端交互脚本（Tab 切换、进度渲染）
 */
import Layout from '@/components/Layout.astro';
import SEO from '@/components/SEO.astro';
import GeoBgDecor from '@/components/GeoBgDecor.astro';
import { modules, getPrimaryCategory, categoryColors } from '@/lib/modules';
import { getAllPaths, type LearningPath, type PathModule } from '@/services/learning-path-service';
import { getRoadmap, type RoadmapPhase, type RoadmapItem } from '@fandex/utils/metadata';
import '@/styles/pages/roadmap.css';

const base = import.meta.env.BASE_URL;

// 从 shd-shared/metadata/roadmap/phases.json 实时读取路线图阶段数据
// phases.json 中 color 字段已为十六进制色值，无需再做分类键映射
type RoadmapArrow = 'right' | null;
const roadmap: RoadmapPhase[] = getRoadmap().map((p) => ({
  phase: p.phase,
  label: p.label,
  desc: p.desc,
  color: p.color,
  items: p.items.map((item) => ({
    id: item.id,
    arrow: item.arrow === 'right' ? 'right' : null,
  })) as RoadmapItem[],
}));

// 从 learning-path-service 获取全部职业学习路径（按 JSON key 顺序）
const learningPaths: LearningPath[] = getAllPaths();

// 优先级中文标签映射
const priorityLabels: Record<PathModule['priority'], string> = {
  required: '必学',
  recommended: '推荐',
  optional: '可选',
};

// 优先级对应的 CSS 颜色类
const priorityColors: Record<PathModule['priority'], string> = {
  required: '#ef4444',
  recommended: '#f59e0b',
  optional: '#6b7280',
};
---

<Layout title="学习路线图">
  <SEO
    slot="head"
    title="学习路线图"
    description="FANDEX 知识库推荐学习路线，从零基础到全栈开发者"
  />

  <div class="roadmap-page">
    <!-- 几何背景装饰层 · docs 变体：文档级克制装饰 -->
    <GeoBgDecor variant="docs" />
    <div class="roadmap-header">
      <h1 class="roadmap-title">学习路线图</h1>
      <a href={base} class="back-home-btn">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"><polyline points="18 6 6 12 18 18"></polyline></svg
        >
        返回主页
      </a>
    </div>

    <!-- 职业学习路径选择区 -->
    <section class="career-paths-section">
      <div class="section-intro">
        <span class="category-tag">职业路径</span>
        <p class="section-desc">选择目标职业，查看推荐学习顺序与预估时长</p>
      </div>

      <div class="path-selector" role="tablist" aria-label="职业学习路径">
        {
          learningPaths.map((path, idx) => (
            <button
              type="button"
              class="path-tab"
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              data-path-id={path.id}
              data-path-name={path.name}
            >
              <span class="path-tab-icon">{path.icon}</span>
              <span class="path-tab-label">{path.name}</span>
            </button>
          ))
        }
      </div>

      <!-- 路径详情容器（客户端动态渲染） -->
      <div id="path-detail" class="path-detail" aria-live="polite">
        <!-- 默认占位：由客户端脚本填充 -->
        <div class="path-detail-loading">选择职业路径查看详情</div>
      </div>
    </section>

    <!-- 学习阶段时间线（保留原有路线图） -->
    <section class="roadmap-timeline-section">
      <div class="section-intro">
        <span class="category-tag">学习阶段</span>
        <p class="section-desc">完整知识体系学习路线，按阶段循序渐进</p>
      </div>

      <div class="roadmap-timeline">
        {
          roadmap.map((phase) => (
            <div class="timeline-phase" style={`--phase-color:${phase.color}`}>
              <div class="phase-marker">
                <span class="phase-number" style={`background:${phase.color}`}>
                  {phase.phase}
                </span>
              </div>
              <div class="phase-content">
                <div class="phase-header">
                  <h2 class="phase-label" style={`color:${phase.color}`}>
                    {phase.label}
                  </h2>
                  <p class="phase-desc">{phase.desc}</p>
                </div>
                <div class="phase-modules">
                  {phase.items.map((item) => {
                    const m = modules.find((mod) => mod.id === item.id);
                    if (!m) return null;
                    return (
                      <div class="roadmap-module-row">
                        <a
                          href={`${base}${m.id}/`}
                          class="roadmap-module-card"
                          style={`--module-color:${categoryColors[getPrimaryCategory(m)]}`}
                          data-progress-module={m.id}
                        >
                          <span class="rm-color-bar" />
                          <div class="rm-body">
                            <span class="rm-title">{m.title}</span>
                            <span class="rm-desc">{m.description}</span>
                            <span class="rm-progress" data-progress-bar />
                          </div>
                        </a>
                        {item.arrow && (
                          <span class="rm-arrow">
                            <svg
                              width="20"
                              height="20"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                            >
                              <polyline points="9 18 15 12 9 6" />
                            </svg>
                          </span>
                        )}
                      </div>
                    );
                  })}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Layout>

<!-- 客户端脚本：将学习路径数据注入页面，供路径选择交互使用。is:inline 声明，避免 Astro 误判为需处理的脚本 -->
<script
  type="application/json"
  id="learning-paths-data"
  is:inline
  set:html={JSON.stringify(learningPaths)}
/>
<script
  type="application/json"
  id="priority-labels"
  is:inline
  set:html={JSON.stringify(priorityLabels)}
/>
<script
  type="application/json"
  id="priority-colors"
  is:inline
  set:html={JSON.stringify(priorityColors)}
/>

<!-- 客户端交互脚本：Tab 切换、路径详情渲染、进度条更新 -->
<script>
  import '@/lib/roadmap-interactions';
</script>
