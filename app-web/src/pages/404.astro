---
// CSS 引入顺序与 BaseLayout.astro 保持一致
// 1. styles/shared — ark 令牌体系（必须最先）
// 2. variables.css — --color-* 兼容层
// 3. tokens.css — --fandex-* 兼容层
// 4. tailwind.css — Tailwind 4 配置
// 5. 业务样式
//
// 样式与交互逻辑已拆分至独立文件：
// - styles/pages/error.css       页面级样式（错误码、搜索框、模块网格、响应式）
// - lib/error-search.ts          客户端脚本（模块名称搜索过滤）
import '@/styles/shared/index.css';
import '@/styles/variables.css';
import '@/styles/tokens.css';
import '@/styles/tailwind.css';
import '@/styles/global.css';
import '@/styles/typography.css';
import '@/styles/code.css';
import '@/styles/components.css';
import '@/styles/geo-decor.css';
import '@/styles/pages/error.css';
import GeoBgDecor from '@/components/GeoBgDecor.astro';
import { modules, categoryColors, getPrimaryCategory } from '@/lib/modules';
import { SITE } from '@/lib/constants';
import { MINIMAL_CSP } from '@/lib/csp';

const base = import.meta.env.BASE_URL;
const topModules = modules.slice(0, 6);
---

<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Security-Policy" content={MINIMAL_CSP} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>404 - 页面未找到 | {SITE.title}</title>

    <link rel="stylesheet" href={`${base}fonts/fonts.css`} />
    <link
      rel="preload"
      href={`${base}fonts/jetbrains-mono-400.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/jetbrains-mono-700.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (function () {
        var raw = localStorage.getItem('fandex-theme');
        var theme;
        if (raw === 'dark' || raw === 'light') {
          theme = raw;
        } else {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        // 始终显式设置 data-theme，避免 tokens.css 的 :root:not([data-theme])
        // 兜底逻辑在 prefers-color-scheme:dark 下覆盖用户已选择的 light
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body>
    <div class="error-page">
      <!-- 几何背景装饰层 · minimal 变体：克制装饰 -->
      <GeoBgDecor variant="minimal" />
      <div class="error-container">
        <div class="error-code">404</div>
        <h1 class="error-title">页面未找到</h1>
        <p class="error-desc">您访问的页面不存在或已被移动。请尝试搜索或浏览以下模块。</p>

        <div class="error-search">
          <!-- 404 页面搜索输入框：aria-label 提供可访问名，placeholder 不作为可访问名替代 -->
          <input
            type="text"
            id="error-search-input"
            placeholder="搜索模块..."
            class="error-search-input"
            aria-label="搜索模块"
          />
        </div>

        <div class="error-modules" id="error-modules">
          {
            topModules.map((m) => (
              <a href={`${base}${m.id}/`} class="error-module-card">
                <span
                  class="error-module-bar"
                  style={`background:${categoryColors[getPrimaryCategory(m)] || categoryColors.toolchain}`}
                />
                <span class="error-module-name">{m.title}</span>
                <span class="error-module-desc">{m.description}</span>
              </a>
            ))
          }
        </div>

        <a href={base} class="error-home-btn">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          返回首页
        </a>
      </div>
    </div>
  </body>
</html>

<!-- 客户端交互脚本：模块名称搜索过滤 -->
<script>
  import '@/lib/error-search';
</script>
