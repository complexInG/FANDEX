---
/**
 * 语法速览页面
 * -----------------------------------------------------------------------------
 * 功能概述：
 * - 汇聚 mobile 文档中的编程语言/标记语言语法要点，提供语言切换 + 速查卡片
 * - 数据管线：scripts/build-syntax.mjs 解析 cnt-content/mobile，
 *   生成轻量语言索引（内嵌）与分语言卡片分块（按需 fetch）
 * - 交互岛：SyntaxExplorer 负责语言切换、卡片渲染、代码复制与增量加载
 *
 * 设计说明：
 * - 延续全站几何科技风：几何背景装饰 + 细线边框 + 分类主题色 + 明暗主题令牌
 * - 遵循"速查做减法"：每张卡片只展示一个语法点的公式与示例代码，
 *   完整内容通过模块文档入口延伸
 * - 语言范围：仅编程语言与数据库命令语言（运维/云计算/测试等不收录）
 */
import HomeLayout from '@/components/HomeLayout.astro'
import SEO from '@/components/SEO.astro'
import GeoBgDecor from '@/components/GeoBgDecor.astro'
import SyntaxExplorer from '@/islands/SyntaxExplorer'
import { getSyntaxIndex, getSyntaxStats } from '@/services'
import { SITE } from '@/lib/constants'
import '@/styles/pages/syntax.css'

// 语言索引与统计（预构建 JSON，轻量内嵌）
const syntaxIndex = getSyntaxIndex()
const syntaxStats = getSyntaxStats()
const base = import.meta.env.BASE_URL

// 代码括号图标（几何 stroke 风格），用于 Hero 强调
const icon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`
---

<HomeLayout title="语法速览">
  <SEO
    slot="head"
    title="语法速览 · FANDEX"
    description="FANDEX 语法速览：汇聚各编程语言语法要点，语言切换快速查阅公式与示例代码。"
    canonical={`${SITE.url}${base}syntax/`}
    type="website"
  />

  <div class="syntax-page">
    <!-- 几何背景装饰：home 变体，与首页/占位页视觉统一 -->
    <GeoBgDecor variant="home" />

    <!-- Hero 区域：功能标题 + 描述 + 数据统计 -->
    <section class="syntax-hero fndx-scroll-reveal">
      <div class="syntax-hero__icon" aria-hidden="true" set:html={icon} />
      <h1 class="syntax-hero__title">语法速览</h1>
      <p class="syntax-hero__desc">
        汇聚各编程语言语法要点，切换语言快速查阅公式与示例代码。
      </p>
      <div class="syntax-hero__stats">
        <span class="syntax-hero__stat">
          <strong>{syntaxStats.totalLanguages}</strong>
          <em>种语言</em>
        </span>
        <span class="syntax-hero__divider" aria-hidden="true"></span>
        <span class="syntax-hero__stat">
          <strong>{syntaxStats.totalCards}</strong>
          <em>个语法点</em>
        </span>
        <span class="syntax-hero__divider" aria-hidden="true"></span>
        <span class="syntax-hero__stat">
          <strong>{syntaxStats.totalDocs}</strong>
          <em>篇文档</em>
        </span>
      </div>
    </section>

    <!-- 语法速查交互区：语言切换 + 卡片网格（按需加载） -->
    <SyntaxExplorer
      client:visible
      languages={syntaxIndex.languages}
      base={base}
    />
  </div>
</HomeLayout>
