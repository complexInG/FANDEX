---
import Layout from '@/components/Layout.astro';
import SEO from '@/components/SEO.astro';
import Sidebar from '@/components/Sidebar.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { getModule, categoryColors, getPrimaryCategory } from '@/lib/modules';
// 通过 doc-service 获取模块文档列表，UI 层禁止直接调用 getCollection
// docSlug 由 modules.ts 唯一定义，通过 services 桶文件统一导出
import { getDocsByModule, docSlug } from '@/services';

export async function getStaticPaths() {
  const { modules } = await import('@/lib/modules');
  return modules.map((m) => ({ params: { module: m.id } }));
}

const { module } = Astro.params as { module: string };
const meta = getModule(module || '');

if (!meta) {
  return Astro.redirect(`${import.meta.env.BASE_URL}404`);
}

// 通过 doc-service 获取当前模块的文档列表（已按 order 升序排序）
const sortedDocs = await getDocsByModule(module);

const breadcrumb = [{ label: '首页', href: `${import.meta.env.BASE_URL}` }, { label: meta.title }];
---

<Layout title={meta.title}>
  <SEO
    slot="head"
    title={meta.title}
    description={meta.description}
    canonical={`${Astro.site}${Astro.url.pathname}`}
  />
  <Sidebar slot="sidebar" moduleId={module} />

  <div class="module-page" style={`--module-color:${categoryColors[getPrimaryCategory(meta)]}`}>
    <Breadcrumb items={breadcrumb} hasSidebar />

    <div class="module-header fndx-scroll-reveal">
      <div class="header-body">
        <h1 class="header-title">{meta.title}</h1>
        <p class="header-desc">{meta.description}</p>
      </div>
    </div>

    {/* 注：原"返回入门指南"按钮已移除 —— 侧边栏顶部已提供"返回首页"按钮，
        该按钮在所有模块目录页重复且地址错误（指向 getting-started 而非首页） */}

    <ul class="doc-list fndx-scroll-reveal-fade">
      {
        sortedDocs.map((doc, idx) => (
          <li class="doc-list-item">
            <a
              href={`${import.meta.env.BASE_URL}${module}/${docSlug(doc.id)}/`}
              class="doc-list-link"
            >
              <span
                class="doc-list-icon"
                style={`background:${categoryColors[getPrimaryCategory(meta)]}`}
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                  <line x1="16" y1="13" x2="8" y2="13" />
                  <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
              </span>
              <span class="doc-list-seq">{String(idx + 1).padStart(3, '0')}</span>
              <span class={`doc-list-difficulty diff-${doc.data.difficulty || 'intermediate'}`}>
                {doc.data.difficulty === 'beginner'
                  ? '入门'
                  : doc.data.difficulty === 'advanced'
                    ? '进阶'
                    : '中级'}
              </span>
              <span class="doc-list-title">{doc.data.title}</span>
              {doc.data.description && <span class="doc-list-desc">{doc.data.description}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>

<style>
  /* 模块文档列表页样式 — 归入 @layer pages，避免未分层 CSS 覆盖 ark 令牌
   * 紧凑化重构：减小图标尺寸、优化间距、添加 max-width 防止大屏越界
   * 宽度自适应桌面端 94vw，移除 48rem 限制 */
  @layer pages {
  .module-page {
    padding: var(--spacing-sm) var(--spacing-md);
    width: 94vw;
    max-width: 100%;
    margin-inline: auto;
  }

  .module-header {
    margin-bottom: var(--spacing-md);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--fandex-radius-md, 4px);
  }

  .header-body {
    padding: var(--spacing-sm) var(--spacing-md);
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  /* 已删除 .header-dot 点状装饰（去卡通化，几何科技风格） */

  /* 注：原 .back-to-start-link 样式已随按钮移除 —— 侧边栏顶部"返回首页"按钮已承担返回功能 */

  .header-title {
    font-family: var(--font-display);
    font-size: 1.05em;
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.01em;
  }

  .header-desc {
    font-size: 0.78em;
    color: var(--color-text-secondary);
    margin: 0;
    flex-basis: 100%;
  }

  .doc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid var(--color-border-light);
  }

  .doc-list-item {
    border-bottom: 1px solid var(--color-border-light);
  }

  .doc-list-item:last-child {
    border-bottom: none;
  }

  /* 文档链接：flex-wrap 允许标题与描述分行显示，增高卡片以容纳多行内容
   * 布局：第一行 = 图标 + 序号 + 难度 + 标题；第二行 = 描述（flex-basis: 100% 强制换行） */
  .doc-list-link {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-xs) var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing-sm);
    color: var(--color-text);
    text-decoration: none;
    transition: background var(--transition-fast), border-color var(--transition-fast);
    border-left: 2px solid transparent;
  }

  .doc-list-link:hover {
    background: var(--color-bg-hover);
    border-left-color: var(--module-color, var(--color-primary));
  }

  /* 文档图标：紧凑化 24px，使用模块分类色而非青色 */
  .doc-list-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-radius: 3px;
    color: var(--color-text-inverse, #fff);
  }

  .doc-list-icon svg {
    width: 12px;
    height: 12px;
  }

  .doc-list-seq {
    font-family: var(--font-display);
    font-size: 0.68em;
    color: var(--color-text-tertiary);
    flex-shrink: 0;
    min-width: 1.8em;
  }

  /* 标题：允许完整显示，超长时换行而非截断（需求6）
   * 移除原 white-space:nowrap / overflow:hidden / text-overflow:ellipsis */
  .doc-list-title {
    font-family: var(--font-display);
    font-size: 0.82em;
    font-weight: 500;
    flex: 1 1 auto;
    min-width: 0;
    word-break: break-word;
    line-height: 1.4;
  }

  .doc-list-difficulty {
    font-size: 0.65em;
    padding: 1px 6px;
    border-radius: 2px;
    flex-shrink: 0;
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .diff-beginner {
    background: color-mix(in srgb, var(--color-success) 15%, var(--color-bg));
    color: var(--color-success);
  }

  .diff-intermediate {
    background: color-mix(in srgb, var(--color-warning) 15%, var(--color-bg));
    color: var(--color-warning);
  }

  /* 进阶难度标识：加强背景色强调（需求4）—— 由 15% 提升至 28%，并加粗字重 */
  .diff-advanced {
    background: color-mix(in srgb, var(--color-danger) 28%, var(--color-bg));
    color: var(--color-danger);
    font-weight: 600;
  }

  /* 描述：独占一行显示（需求7）—— flex-basis:100% 强制换行到新行
   * 移除原 white-space:nowrap，允许长描述自然换行 */
  .doc-list-desc {
    flex-basis: 100%;
    padding-left: calc(24px + var(--spacing-sm));
    font-size: 0.72em;
    color: var(--color-text-tertiary);
    line-height: 1.5;
    word-break: break-word;
  }
  } /* end @layer pages */
</style>
