---
/**
 * 搜索页
 * 基于 Pagefind 静态搜索库提供全文搜索功能
 *
 * 样式与交互逻辑已拆分至独立文件：
 * - styles/pages/search.css       页面级样式（容器、筛选器、Pagefind UI 主题映射）
 * - lib/search-pagefind.ts        客户端脚本（Pagefind 加载、UI 初始化、筛选器绑定）
 */
import Layout from '@/components/Layout.astro';
import SEO from '@/components/SEO.astro';
import GeoBgDecor from '@/components/GeoBgDecor.astro';
import { modules } from '@/lib/modules';
import '@/styles/pages/search.css';
---

<Layout title="搜索">
  <SEO slot="head" title="搜索 - FANDEX" description="全文搜索知识库" type="website" />
  <div class="search-page">
    <!-- 几何背景装饰层 · minimal 变体：克制装饰 -->
    <GeoBgDecor variant="minimal" />
    <h1 class="search-title">搜索</h1>
    <div class="search-filters">
      <select id="filter-module" class="search-filter-select" aria-label="按模块筛选">
        <option value="">全部模块</option>
        {modules.map((m) => <option value={m.id}>{m.title}</option>)}
      </select>
      <select id="filter-difficulty" class="search-filter-select" aria-label="按难度筛选">
        <option value="">全部难度</option>
        <option value="beginner">Beginner</option>
        <option value="intermediate">Intermediate</option>
        <option value="advanced">Advanced</option>
      </select>
    </div>
    <div id="search" class="search-container"></div>
    <noscript>
      <p class="search-noscript">需要启用 JavaScript 才能使用搜索功能</p>
    </noscript>
  </div>
</Layout>

<!-- 客户端交互脚本：Pagefind 初始化、筛选器绑定、View Transitions 兼容 -->
<script>
  import '@/lib/search-pagefind';
</script>
