---
/**
 * 学习路线页面（占位）
 * -----------------------------------------------------------------------------
 * 功能规划：
 *   可视化学习路径图，按模块依赖关系推荐学习顺序，支持进度追踪
 *
 * 当前状态：即将推出，使用 ComingSoon 组件呈现占位视图
 * 后续实现：替换为依赖图可视化 + 个性化路径推荐 + 进度持久化
 *
 * 命名说明：
 *   采用 learning-path 而非 roadmap，因历史 roadmap.astro 已按项目约束移除，
 *   避免与已删除页面命名冲突（见 project_memory: roadmap must be removed）
 */
import HomeLayout from '@/components/HomeLayout.astro'
import SEO from '@/components/SEO.astro'
import ComingSoon from '@/components/ComingSoon.astro'
import { SITE } from '@/lib/constants'

const base = import.meta.env.BASE_URL

// 路径节点图标（几何 stroke 风格）
const icon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2"/><circle cx="18" cy="18" r="2"/><path d="M6 8v4a4 4 0 0 0 4 4h4"/></svg>`
---

<HomeLayout title="学习路线">
  <SEO
    slot="head"
    title="学习路线 · FANDEX"
    description="FANDEX 学习路线：可视化学习路径图，按模块依赖关系推荐学习顺序。"
    canonical={`${SITE.url}${base}learning-path/`}
    type="website"
  />
  <ComingSoon
    title="学习路线"
    description="可视化学习路径图，按模块依赖关系推荐学习顺序，支持进度追踪。"
    icon={icon}
    accentColor="#8b5cf6"
  />
</HomeLayout>
