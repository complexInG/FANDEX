---
/**
 * 在线编程沙箱页面
 *
 * 功能概述：
 *   - 自由编辑多语言代码（JS/TS/Python/C/C++/Go/Java/Kotlin/Rust/C#/Lua/SQL/Shell）
 *   - 支持运行的语言在浏览器沙箱内直接执行，代码草稿按语言自动保存
 */
import HomeLayout from '@/components/HomeLayout.astro'
import SEO from '@/components/SEO.astro'
import CodeLab from '@/islands/playground/CodeLab'
import { SITE } from '@/lib/constants'
import '@/styles/islands/playground.css'

const base = import.meta.env.BASE_URL
---

<HomeLayout title="在线编程沙箱">
  <SEO
    slot="head"
    title="在线编程沙箱 · FANDEX"
    description="FANDEX 在线编程沙箱：支持多语言编辑与语法高亮，常用语言可在浏览器内直接运行，代码草稿自动保存在本地。"
    canonical={`${SITE.url}${base}playground/lab/`}
    type="website"
  />
  <CodeLab client:load />
</HomeLayout>
