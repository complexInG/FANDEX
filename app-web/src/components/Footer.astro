---
/**
 * Footer 组件 — 极简页脚
 * 渲染项目版权信息与 GitHub、MIT License 链接
 */
import { SITE } from '@/lib/constants';

interface Props {
  /** 当前页面标识，预留用于未来导航高亮 */
  currentPath?: string;
}

const { currentPath: _currentPath } = Astro.props;

/** 项目发布起始年份 */
const PROJECT_START_YEAR = 2026;
const currentYear = new Date().getFullYear();
/** 年份范围：若当前年份与起始年份相同则单值，否则范围显示 */
const yearRange =
  currentYear > PROJECT_START_YEAR
    ? `${PROJECT_START_YEAR}-${currentYear}`
    : `${PROJECT_START_YEAR}`;

/** 居中布局修饰符 */
const footerClass = 'fndx-footer fndx-footer--centered fndx-footer--minimal';
---

<footer class={footerClass} role="contentinfo" aria-label="站点页脚">
  <div class="fndx-footer__container">
    {/* 导航链接组 */}
    <nav class="fndx-footer__nav" aria-label="页脚导航">
      <a
        href="https://github.com/fanquanpp/FANDEX"
        class="fndx-footer__nav-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      <span class="fndx-footer__nav-divider" aria-hidden="true">·</span>
      <a
        href="https://github.com/fanquanpp/FANDEX/blob/main/LICENSE"
        class="fndx-footer__nav-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        MIT License
      </a>
    </nav>

    {/* 底部版权区 */}
    <div class="fndx-footer__bottom">
      <p class="fndx-footer__copyright">
        Copyright (c) {yearRange} {SITE.author || 'fanquanpp'} · MIT License · 计算机科学自学平台
      </p>
    </div>
  </div>
</footer>
