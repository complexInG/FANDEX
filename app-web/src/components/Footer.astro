---
/**
 * Footer 组件 — 极简单行页脚
 * -----------------------------------------------------------------------------
 * 职责：
 *   1. 渲染单行版权信息，保持页面底部轻量
 *   2. 预留扩展点（注释区块），后续可添加导航/统计/生态链接等
 *
 * 设计原则：
 *   - 当前仅显示版权一行，避免占用过多垂直空间
 *   - 后续重新设计时在此处添加分区，不影响现有布局
 *   - 消费 @fandex/styles 中 .fndx-footer 命名规范
 *
 * 扩展预留点：
 *   <!-- 扩展点 1：导航链接组 -->
 *   <!-- 扩展点 2：统计数据区 -->
 *   <!-- 扩展点 3：生态联动链接 -->
 *   <!-- 扩展点 4：注意事项/技术信息 -->
 */
import { SITE } from '@/lib/constants';

interface Props {
  /** 当前页面标识，预留用于未来导航高亮 */
  currentPath?: string;
}

const { currentPath: _currentPath } = Astro.props;
const currentYear = new Date().getFullYear();

/** 居中布局修饰符 */
const footerClass = 'fndx-footer fndx-footer--centered fndx-footer--minimal';
---

<footer class={footerClass} role="contentinfo" aria-label="站点页脚">
  <div class="fndx-footer__container">
    {/* 底部版权区（单行） */}
    <div class="fndx-footer__bottom">
      <p class="fndx-footer__copyright">
        Copyright (c) 2024-{currentYear} {SITE.author || 'fanquanpp'} · MIT License
      </p>
    </div>

    {/* ===== 扩展预留点 =====
         后续重新设计页脚时，在此处添加以下分区：
         - 导航链接组（nav.fndx-footer__nav）
         - 统计数据区（div.fndx-footer__stats）
         - 生态联动链接（div.fndx-footer__eco-links）
         - 注意事项/技术信息（p.fndx-footer__notice）
         样式类已在 layout-components.css 中定义，可直接使用。
    ====================== */}
  </div>
</footer>
