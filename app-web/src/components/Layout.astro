---
/**
 * 文档页主布局组件
 * 提供文档页面的整体结构：顶部导航栏、侧边栏、主内容区、移动端底部导航
 * 支持暗色模式切换、全屏模式、侧边栏状态持久化、代码复制、Mermaid 图表渲染等功能
 * 继承 BaseLayout 的共享 head 与样式引入，仅保留文档页特有的结构与脚本
 */
import BaseLayout from '@/components/BaseLayout.astro';
import ThemeToggle from '@/islands/ThemeToggle';
import PerformanceMonitor from '@/components/PerformanceMonitor.astro';
import ReadingProgress from '@/components/ReadingProgress.astro';
import { SITE } from '@/lib/constants';

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
// 检测是否包含侧边栏/目录大纲插槽，用于条件渲染遮罩层、移动端导航按钮和三栏布局
const hasSidebar = Astro.slots.has('sidebar');
const hasToc = Astro.slots.has('toc');
---

<BaseLayout title={title}>
  <slot name="head" slot="head" />

  <!-- 确保页面撑满视口高度，body 使用 min-height 避免内容截断；滚动由 .app-main 内部容器控制 -->
  <style is:inline>
    html {
      height: 100%;
    }
    body {
      /* 渐进增强：iOS <15 不支持 100dvh 时回退到 100vh；min-height 允许内容超出时 body 自然扩展 */
      min-height: 100vh;
      min-height: 100dvh;
    }
  </style>
  <!-- 侧边栏遮罩层：移动端打开侧边栏时显示，点击关闭（使用共享 .fndx-sidebar-backdrop 样式） -->
  {hasSidebar && <div class="fndx-sidebar-backdrop" id="sidebar-backdrop" />}
  <!-- 阅读进度条：固定于页面顶部，由本地组件提供（原 @fandex/astro-components 已迁入 app-web） -->
  <ReadingProgress />
  <!-- 主布局容器：根据侧边栏/目录大纲存在情况添加不同类名，支持三栏布局 -->
  <div
    class="app-layout"
    class:list={{ 'no-sidebar': !hasSidebar, 'has-toc': hasToc }}
  >
    <!-- 顶部导航栏 -->
    <header class="app-nav">
      <div class="nav-left">
        <a href={base} class="nav-logo">
          <span class="logo-mark"></span>
          <span class="logo-text">{SITE.title}<span class="logo-home-suffix">-Index</span></span>
        </a>
      </div>
      <div class="nav-right">
        <!-- 返回顶部按钮 -->
        <button class="nav-back-to-top" id="nav-back-to-top" aria-label="返回顶部" title="返回顶部">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
          <span class="nav-back-to-top-text">返回顶部</span>
        </button>
        <!-- 主题切换按钮（Vue 交互组件） -->
        <ThemeToggle client:load />
      </div>
    </header>
    <!-- 侧边栏插槽 -->
    <slot name="sidebar" />
    <!-- 主内容区域 -->
    <main class="app-main" id="app-main">
      <slot />
    </main>
    <!-- 目录大纲插槽（仅桌面端显示，由 .fndx-toc CSS 控制响应式显隐） -->
    {hasToc && <slot name="toc" />}
  </div>
  <!-- 移动端底部导航栏 -->
  <nav class="mobile-nav">
    <a href={base} class="mobile-nav-link">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span>首页</span>
    </a>
    <!-- 模块切换按钮：仅在有侧边栏时显示 -->
    {
      hasSidebar && (
        <button class="mobile-nav-link" id="mobile-sidebar-btn" aria-label="模块">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
          </svg>
          <span>模块</span>
        </button>
      )
    }
    <!-- 全屏切换按钮 -->
    <button class="mobile-nav-link" id="mobile-fullscreen-btn" aria-label="全屏">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
        ></path>
      </svg>
      <span>全屏</span>
    </button>
  </nav>
  <!-- 性能监控面板：仅开发环境渲染（组件内部通过 import.meta.env.DEV 控制） -->
  <PerformanceMonitor />
</BaseLayout>

<!-- 客户端交互脚本：侧边栏开关、全屏切换、代码复制、Mermaid 渲染、SW 注册等 -->
<script>
  import '@/lib/layout-interactions';
</script>

<style>
  /* 菜单切换按钮：默认隐藏，移动端显示
   * 注：遮罩层样式已迁移至 @fandex/styles 的 .fndx-sidebar-backdrop */
  .nav-toggle {
    display: none;
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: flex;
    }
  }
</style>
