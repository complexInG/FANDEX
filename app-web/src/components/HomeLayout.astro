---
/**
 * 首页布局组件
 * 提供首页的整体结构：顶部导航栏和主内容区
 * 导航栏包含 GitHub 仓库链接、全屏按钮和主题切换
 * 继承 BaseLayout 的共享 head 与样式引入，仅保留首页特有的结构与脚本
 *
 * 样式与交互逻辑已拆分至独立文件：
 * - styles/components/home-layout.css       布局样式（导航栏、主内容区、响应式）
 * - lib/home-layout-interactions.ts          客户端脚本（全屏切换与持久化）
 */
import BaseLayout from '@/components/BaseLayout.astro';
import ThemeToggle from '@/islands/ThemeToggle';
import { SITE } from '@/lib/constants';
import '@/styles/components/home-layout.css';

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={title}>
  <slot name="head" slot="head" />

  <!-- 首页滚动架构：body 禁止滚动，所有纵向滚动由 .home-main 内部容器处理
       防止快速上下滑动时 body 扩展产生无限空页面 -->
  <style is:inline>
    @layer base {
    html {
      height: 100%;
      overscroll-behavior: none;
    }
    body {
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      overscroll-behavior: none;
    }
    }
  </style>

  <!-- 首页顶部导航栏 -->
  <header class="home-nav">
    <div class="nav-left">
      <a href={base} class="nav-logo">
        <span class="logo-mark"></span>
        <span class="logo-text">{SITE.title}</span>
      </a>
    </div>
    <div class="nav-right">
      <!-- GitHub 仓库链接 -->
      <a
        href="https://github.com/fanquanpp/FANDEX"
        class="nav-github-link"
        target="_blank"
        rel="noopener noreferrer"
        data-tooltip="GitHub 源仓库"
        data-tooltip-pos="bottom"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path></svg
        >
        <span class="nav-github-text">GitHub 源仓库</span>
      </a>
      <!-- 全屏按钮：仅移动端显示 -->
      <button class="nav-fullscreen-btn" id="home-fullscreen-btn" aria-label="全屏" data-tooltip="全屏" data-tooltip-pos="bottom">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"
          ></path>
        </svg>
      </button>
      <!-- 主题切换按钮 -->
      <ThemeToggle client:load />
    </div>
  </header>
  <!-- 首页主内容区 -->
  <main class="home-main">
    <slot />
  </main>
</BaseLayout>

<!-- 客户端交互脚本：全屏模式切换与状态持久化 -->
<script>
  import '@/lib/home-layout-interactions';
</script>
