---
/**
 * ComingSoon 占位组件
 * -----------------------------------------------------------------------------
 * 职责：
 *   为尚未实现的功能页面提供统一的"即将推出"占位视图
 *
 * 设计原则：
 *   - 复用 HomeLayout 导航与主题切换，保持全站视觉一致
 *   - 几何科技风格：细线边框 + 模块分类色 + 几何图标
 *   - 极简结构，无交互负担，后续替换为实际功能即可
 *
 * Props:
 *   title       - 功能名称（如"在线编程"）
 *   description - 功能简述（一句话说明用途）
 *   icon        - SVG 图标字符串（24x24，stroke 风格）
 *   accentColor - 主题强调色（默认使用 --color-accent-base）
 */
import GeoBgDecor from '@/components/GeoBgDecor.astro'

interface Props {
  title: string
  description: string
  icon: string
  accentColor?: string
}

const { title, description, icon, accentColor } = Astro.props as Props
---

<div
  class="coming-soon-page"
  style={accentColor ? `--cs-accent:${accentColor}` : undefined}
>
  <!-- 几何背景装饰层 · home 变体复用，保持视觉统一 -->
  <GeoBgDecor variant="home" />

  <section class="coming-soon">
    <!-- 几何图标：细线边框 + 模块强调色 -->
    <div class="cs-icon" aria-hidden="true" set:html={icon} />

    <!-- 功能标题与描述 -->
    <h1 class="cs-title">{title}</h1>
    <p class="cs-desc">{description}</p>

    <!-- 状态标识：即将推出 -->
    <div class="cs-badge">
      <span class="cs-badge-dot" aria-hidden="true"></span>
      <span class="cs-badge-text">即将推出</span>
    </div>

    <!-- 返回首页链接 -->
    <a href={import.meta.env.BASE_URL} class="cs-back">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="15 18 9 12 15 6" />
      </svg>
      <span>返回首页</span>
    </a>
  </section>
</div>

<style>
  /* ComingSoon 占位页样式 — 归入 @layer pages，避免未分层 CSS 覆盖 ark 令牌 */
  @layer pages {
    .coming-soon-page {
      position: relative;
      width: 94vw;
      max-width: 100%;
      min-height: calc(100vh - var(--nav-height));
      min-height: calc(100dvh - var(--nav-height));
      margin: 0 auto;
      padding: 0 var(--spacing-xl) var(--spacing-3xl);
    }

    /* 确保内容层在几何装饰层之上 */
    .coming-soon-page > section {
      position: relative;
      z-index: 1;
    }

    /* 居中容器：flex 垂直居中，营造仪式感 */
    .coming-soon {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: var(--spacing-3xl) var(--spacing-md);
      min-height: 60vh;
      gap: var(--spacing-md);
    }

    /* 几何图标容器：细线边框 + 强调色，64px 方形 */
    .cs-icon {
      width: 64px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid color-mix(in oklch, var(--cs-accent, var(--color-accent-base)) 40%, transparent);
      border-radius: var(--fandex-radius-md, 4px);
      color: var(--cs-accent, var(--color-accent-base));
      background: color-mix(in oklch, var(--cs-accent, var(--color-accent-base)) 6%, transparent);
    }

    .cs-icon :global(svg) {
      width: 28px;
      height: 28px;
    }

    /* 功能标题：ark 大字号粗体 */
    .cs-title {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--color-fg-primary);
      margin: 0;
      letter-spacing: 0.04em;
    }

    /* 功能描述：克制次要色 */
    .cs-desc {
      font-size: 0.88rem;
      color: var(--color-fg-secondary);
      margin: 0;
      max-width: 420px;
      line-height: 1.6;
    }

    /* 状态徽章：脉冲圆点 + 文字 */
    .cs-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border: 1px solid var(--color-border-light);
      border-radius: var(--fandex-radius-pill, 9999px);
      background: var(--color-bg-elevated);
      font-family: var(--font-display);
      font-size: 0.72rem;
      color: var(--color-fg-tertiary);
      letter-spacing: 0.06em;
    }

    /* 脉冲圆点：呼吸动画提示开发中 */
    .cs-badge-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--cs-accent, var(--color-accent-base));
      animation: cs-pulse 2s ease-in-out infinite;
    }

    @keyframes cs-pulse {
      0%, 100% { opacity: 0.4; transform: scale(0.85); }
      50% { opacity: 1; transform: scale(1.15); }
    }

    /* 返回首页链接：ark 描边按钮风格 */
    .cs-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--color-fg-secondary);
      text-decoration: none;
      font-family: var(--font-display);
      font-size: 0.82rem;
      font-weight: 500;
      padding: 6px 14px;
      border: 1px solid var(--color-border-light);
      border-radius: var(--fandex-radius-sm, 2px);
      background: transparent;
      transition:
        color var(--motion-duration-instant) var(--motion-easing-out),
        border-color var(--motion-duration-instant) var(--motion-easing-out),
        background-color var(--motion-duration-instant) var(--motion-easing-out);
    }

    .cs-back:hover {
      color: var(--cs-accent, var(--color-accent-base));
      border-color: color-mix(in oklch, var(--cs-accent, var(--color-accent-base)) 50%, transparent);
      background-color: color-mix(in oklch, var(--cs-accent, var(--color-accent-base)) 6%, transparent);
    }

    /* 移动端适配 */
    @media (max-width: 768px) {
      .coming-soon-page {
        padding: 0 var(--spacing-md) var(--spacing-2xl);
      }

      .cs-title {
        font-size: 1.4rem;
      }

      .cs-desc {
        font-size: 0.82rem;
      }
    }

    /* 尊重用户减少动效偏好：禁用脉冲动画 */
    @media (prefers-reduced-motion: reduce) {
      .cs-badge-dot {
        animation: none;
        opacity: 0.8;
      }
    }
  }
</style>
