---
/**
 * Sidebar 侧边栏组件（web 端）
 *
 * 功能概述：
 * - 文档页左侧导航面板，展示当前模块文档列表与全部模块视图
 * - 章节视图：当前模块的文档列表，按 order 排序，含进度指示器
 * - 全部模块视图：模块按分类分组，预渲染子文档列表，支持点击展开/收起
 * - sessionStorage 滚动位置记忆（导航后恢复滚动位置）
 * - 模块折叠状态持久化（通过 localStorage 的 expanded 集合）
 * - 基于 @fandex/styles 的 .fndx-sidebar 命名规范实现样式
 * - 完整无障碍：aside[aria-label="侧边栏"]、aria-current="page"
 *
 * 设计变更：
 * - 原"资料"视图（内嵌标题大纲）已移除，改由共享 TableOfContents 组件
 *   在文档页右侧 toc 插槽渲染（见 shd-shared/asc-astro-components/TableOfContents.astro）
 * - headings Prop 保留用于未来扩展，但不再驱动侧边栏视图切换
 *
 * Props:
 *   moduleId    - 当前模块 ID（如 `frontend/javascript`）
 *   currentSlug - 当前文档 slug（用于高亮）
 *   sortedDocs  - 已排序的文档集合（可选，避免重复查询）
 */
// categoryColors 和 getPrimaryCategory 为静态样式数据，保留从 @/lib/modules 导入
import { categoryColors, getPrimaryCategory } from '@/lib/modules'
// 通过 doc-service 和 module-service 获取数据，UI 层禁止直接调用 getCollection
import {
  getModule,
  getDocsByModule,
  getCategories,
  getModulesByCategory,
  // 全部模块面板改用预构建索引缓存（getDocsIndex），避免运行时全量 getCollection 导致 dev 模式 OOM
  // 章节面板仍用 getDocsByModule（仅查询当前模块，文档量小无 OOM 风险）
  getDocsIndex,
  docSlug,
  type DocEntry,
  type DocIndexItem,
  type Module,
  type CategoryInfo,
} from '@/services'

const { moduleId, currentSlug, sortedDocs } = Astro.props as {
  moduleId: string
  currentSlug?: string
  headings?: { depth: number; slug: string; text: string }[]
  sortedDocs?: DocEntry[]
}

// 通过 doc-service 获取当前模块文档列表，支持外部传入已排序列表以避免重复查询
const sorted = sortedDocs || await getDocsByModule(moduleId)
const meta = getModule(moduleId)
// 通过 module-service 获取分类列表，用于"全部模块"面板按分类分组渲染
const categories = getCategories()

/**
 * 预加载文档索引并按 module 字段分组
 *
 * 实现说明：
 * - 读取预构建的 doc-index.json（由 scripts/build-stats.mjs 生成），
 *   仅含 slug/module/title/order 四个轻量字段，避免运行时全量 getCollection('docs')
 *   加载 2000+ 篇文档正文导致 dev 模式 OOM
 * - 索引数组已在构建期按 module 字母序 + order 升序排序，分组后顺序保持不变，无需再次排序
 * - 渲染时内联到 HTML，客户端点击展开按钮切换显隐，无需网络请求
 *
 * 性能对比：
 * - 旧方案 getAllDocs()：dev 模式每页请求全量加载 2000+ DocEntry（含 body/render），12GB 堆内存 OOM
 * - 新方案 getDocsIndex()：读取静态 import JSON（~180KB），O(1) 内存占用，dev/build 模式均无 OOM 风险
 */
const docsIndex = getDocsIndex()
const docsByModule: Map<string, DocIndexItem[]> = new Map()
for (const doc of docsIndex) {
  const m = doc.module
  if (!docsByModule.has(m)) docsByModule.set(m, [])
  docsByModule.get(m)?.push(doc)
}

const base = import.meta.env.BASE_URL

/** 构建文档链接（兼容 BASE_URL） */
function docHref(slug: string): string {
  return `${base}${moduleId}/${slug}/`
}

/** 模块首页链接 */
function moduleHref(id: string): string {
  return `${base}${id}/`
}

/** 获取模块的主分类颜色（用于色条/圆点）
 *  categoryColors[key] 在 noUncheckedIndexedAccess 下返回 string | undefined，
 *  此处通过 ?? '' 兜底确保返回 string，外层调用方已通过 --module-color CSS 变量提供默认色
 *
 *  注意：返回空字符串时，调用方不应将 --module-color 设为空串，
 *  因为 var(--module-color, fallback) 在变量值为空串时返回空串而非 fallback，
 *  会导致 color-mix() 等函数失效。应通过 moduleColorStyle() 条件化设置。 */
function moduleColor(m: Module | undefined): string {
  if (!m) return categoryColors.tools ?? ''
  return categoryColors[getPrimaryCategory(m)] ?? categoryColors.tools ?? ''
}

/** 生成 --module-color 的 inline style 字符串
 *  仅在颜色非空时设置，避免空串导致 var() fallback 失效 */
function moduleColorStyle(m: Module | undefined): string | undefined {
  const color = moduleColor(m)
  return color ? `--module-color:${color}` : undefined
}
---

<aside
  id="app-sidebar"
  class="fndx-sidebar"
  aria-label="侧边栏"
  data-module={moduleId}
  style={moduleColorStyle(meta)}
>
  <!-- 移动端关闭按钮（抽屉模式可见）：统一 fndx-icon-btn 风格 -->
  <button
    type="button"
    id="sidebar-close-btn"
    class="fndx-sidebar__close fndx-icon-btn"
    aria-label="关闭侧边栏"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  </button>

  <!-- 共享顶部固定区：折叠按钮 + 视图切换 tabs + 返回首页
       独立于两个面板之外，确保切换视图时 tabs 与折叠按钮始终可见 -->
  <div class="fndx-sidebar__top">
    <!-- 折叠收纳按钮：点击后将整个侧边栏折叠，释放阅读空间 -->
    <button
      type="button"
      id="sidebar-collapse-btn"
      class="fndx-sidebar__collapse fndx-icon-btn"
      aria-label="折叠侧边栏"
      data-tooltip="折叠侧边栏"
      data-tooltip-pos="right"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="15 18 9 12 15 6" />
      </svg>
    </button>

    <!-- 视图切换 tabs：章节 / 全部模块
         样式由 .fndx-sidebar__view-tabs / .fndx-sidebar__view-tab 提供（layout-components.css）
         点击切换面板显隐，状态持久化到 localStorage -->
    <div class="fndx-sidebar__view-tabs" role="tablist" aria-label="侧边栏视图切换">
      <button
        type="button"
        class="fndx-sidebar__view-tab is-active"
        data-view="chapters"
        role="tab"
        aria-selected="true"
      >
        章节
      </button>
      <button
        type="button"
        class="fndx-sidebar__view-tab"
        data-view="modules"
        role="tab"
        aria-selected="false"
      >
        全部
      </button>
    </div>

    <!-- 返回首页（图标按钮，hover 显现 tooltip 语义） -->
    <a
      href={base}
      class="fndx-sidebar__back fndx-icon-btn"
      aria-label="返回首页"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
        <polyline points="9 22 9 12 15 12 15 22" />
      </svg>
    </a>
  </div>

  <!-- 章节导航面板：当前模块的文档列表 -->
  <nav
    id="sidebar-chapters-panel"
    class="fndx-sidebar__panel"
    aria-label="章节导航"
  >
    <div
      id="sidebar-scroll"
      class="fndx-sidebar__scroll"
    >
      <!-- 模块标题（从顶部区移入滚动区，避免与 tabs 争抢空间） -->
      <h2 class="fndx-sidebar__title fndx-sidebar__title--module">
        {meta?.title || moduleId}
      </h2>
      <ul
        id="sidebar-panel-chapters"
        class="fndx-sidebar__list"
      >
        {
          sorted.map((doc) => {
            const slug = docSlug(doc.id)
            const isActive = currentSlug === slug
            return (
              <li>
                <a
                  href={docHref(slug)}
                  class={`fndx-sidebar__link${isActive ? ' is-active' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span class="fndx-sidebar__link-text">{doc.data.title}</span>
                </a>
              </li>
            )
          })
        }
      </ul>
    </div>
  </nav>

  <!-- 全部模块面板（默认隐藏，点击 tabs 切换显示） -->
  <nav
    id="sidebar-all-modules-panel"
    class="fndx-sidebar__panel is-hidden"
    aria-label="全部模块"
  >
    <div
      id="sidebar-all-modules-scroll"
      class="fndx-sidebar__scroll"
    >
      {
        categories.map((category: CategoryInfo) => {
          const modulesInCategory = getModulesByCategory(category.id)
          if (modulesInCategory.length === 0) return null
          return (
            <div class="fndx-sidebar__group">
              <h3 class="fndx-sidebar__group-title" style={category.color ? `--module-color:${category.color}` : undefined}>
                {category.label}
              </h3>
              <ul class="fndx-sidebar__list">
                {modulesInCategory.map((m: Module) => {
                  const moduleDocs = docsByModule.get(m.id) ?? []
                  const hasDocs = moduleDocs.length > 0
                  return (
                    <li class="fndx-sidebar__module" data-module={m.id}>
                      <div class="fndx-sidebar__module-row">
                        <a
                          href={moduleHref(m.id)}
                          class={`fndx-sidebar__link${m.id === moduleId ? ' is-active' : ''}`}
                          style={moduleColorStyle(m)}
                          aria-current={m.id === moduleId ? 'page' : undefined}
                        >
                          <span class="fndx-sidebar__link-text">{m.title}</span>
                        </a>
                        {hasDocs && (
                          <button
                            type="button"
                            class="fndx-sidebar__module-arrow"
                            aria-label={`展开 ${m.title} 文档列表`}
                            aria-expanded="false"
                            data-module-toggle={m.id}
                          >
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              class="fndx-sidebar__module-arrow-icon"
                              aria-hidden="true"
                            >
                              <polyline points="9 18 15 12 9 6" />
                            </svg>
                          </button>
                        )}
                      </div>
                      {hasDocs && (
                        <ul
                          class="fndx-sidebar__module-docs is-collapsed"
                          data-module={m.id}
                        >
                          {moduleDocs.map((doc: DocIndexItem) => {
                            // doc.slug 已是预构建期与 docSlug(collectionId) 等价的 slug，无需再次调用 docSlug
                            const docIsActive = m.id === moduleId && currentSlug === doc.slug
                            return (
                              <li>
                                <a
                                  href={`${base}${m.id}/${doc.slug}/`}
                                  class={`fndx-sidebar__link fndx-sidebar__link--sub${docIsActive ? ' is-active' : ''}`}
                                  style={moduleColorStyle(m)}
                                  aria-current={docIsActive ? 'page' : undefined}
                                >
                                  <span class="fndx-sidebar__link-text">{doc.title}</span>
                                </a>
                              </li>
                            )
                          })}
                        </ul>
                      )}
                    </li>
                  )
                })}
              </ul>
            </div>
          )
        })
      }
    </div>
  </nav>
</aside>

<!-- 浮动展开按钮：侧边栏折叠后显示在左边缘顶部，点击恢复侧边栏
     含"展开"文字标注，避免单独 svg 图标语义不明；统一 fndx-icon-btn 风格 -->
<button
  type="button"
  id="sidebar-expand-fab"
  class="fndx-sidebar__expand-fab fndx-icon-btn fndx-icon-btn--labeled"
  aria-label="展开侧边栏"
  data-tooltip="展开侧边栏"
  data-tooltip-pos="right"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polyline points="9 18 15 12 9 6" />
  </svg>
  <span class="fndx-sidebar__expand-fab-text">展开</span>
</button>

<!-- 客户端交互脚本：侧边栏滚动记忆、进度标记、模块折叠、视图切换、折叠收纳 -->
<script>
  import '@/lib/sidebar-interactions';
</script>
