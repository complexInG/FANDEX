---
/**
 * 模块卡片组件
 * 用于首页展示各学习模块的入口卡片
 * 包含模块图标、标题和描述，点击跳转到对应模块首页
 *
 * 样式已拆分至 styles/components/module-card.css
 */
import '@/styles/components/module-card.css';

const { mod, color } = Astro.props as {
  mod: {
    id: string;
    title: string;
    icon: string;
    description: string;
    categories: readonly string[];
  };
  color: string;
};
---

<!-- 模块卡片：点击跳转到模块首页
     --module-color 注入到卡片根元素，使 ::before 上边线、hover 标题色、
     card-icon 均统一消费模块分类色（非 web 主题青色） -->
<a href={`${import.meta.env.BASE_URL}${mod.id}/`} class="module-card" style={`--module-color:${color}`}>
  <!-- 模块图标：几何科技风，透明底 + 细边框 + 分类色文字 -->
  <span class="card-icon">{mod.icon}</span>
  <div class="card-body">
    <h3 class="card-title">{mod.title}</h3>
    <p class="card-desc">{mod.description}</p>
  </div>
</a>

