---
/**
 * 功能入口导航（纯文字按钮 + SVG 波浪描边动画）
 * -----------------------------------------------------------------------------
 * 复用 Hero 区的 entry-btn 视觉语言：
 * - 透明背景 + 二次贝塞尔曲线（Q 命令）绘制手绘风格波浪路径
 * - hover 时 stroke-dashoffset 从 250 → 0 实现路径书写动画
 * - 通过 --entry-color 定制描边与悬停文字颜色，缺省回退全局强调色
 * - variant="category" 时附加 category-entries 修饰类，使用紧凑尺寸，
 *   适配分类标题下方的快捷入口
 */
interface Props {
  /** 导航无障碍标签（aria-label） */
  ariaLabel: string
  /** 描边/悬停主题色；缺省使用 var(--color-accent-base) */
  entryColor?: string
  /** 尺寸变体：hero（默认，较大）或 category（紧凑适中） */
  variant?: 'hero' | 'category'
}

const { ariaLabel, entryColor, variant = 'hero' } = Astro.props

// 三大功能入口：与 Hero 区保持一致，供各分类快捷复用
const entries = [
  { href: 'playground/', name: '在线编程', tooltip: '在线编程沙箱' },
  { href: 'syntax/', name: '语法速览', tooltip: '语法快速查阅' },
  { href: 'learning-path/', name: '学习路线', tooltip: '系统化学习路径' },
]

// 分类变体附加修饰类，用于 CSS 中缩小尺寸并接管描边颜色
const navClass = variant === 'category' ? 'hero-entries category-entries' : 'hero-entries'
// 仅在有自定义颜色时输出 style，避免无意义的空属性
const navStyle = entryColor ? `--entry-color:${entryColor}` : undefined
---

<nav class={navClass} aria-label={ariaLabel} style={navStyle}>
  {entries.map(entry => (
    <a
      href={`${import.meta.env.BASE_URL}${entry.href}`}
      class="entry-btn"
      data-tooltip={entry.tooltip}
      data-tooltip-pos="bottom"
    >
      <svg class="entry-border" viewBox="0 0 200 52" preserveAspectRatio="none" aria-hidden="true">
        <path d="M10,26 Q30,6 60,10 T110,26 T160,42 T190,26"/>
      </svg>
      <span class="entry-name">{entry.name}</span>
    </a>
  ))}
</nav>
