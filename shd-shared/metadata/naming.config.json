{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fandex.local/schemas/naming.config.json",
  "title": "FANDEX Naming Config",
  "description": "FANDEX 命名模式集中配置。content-scanner 据此解析文件夹与文档名，消除硬编码正则。修改此文件即可调整命名规则，无需改动扫描器代码。",
  "config_version": "1.0.0",
  "folder": {
    "description": "文件夹命名规则：NNN-english-short（如 001-getting-started）",
    "pattern": "^(\\d{3})-([a-z][a-z0-9-]*)$",
    "groups": {
      "order": 1,
      "english_short": 2
    },
    "order_min": 1,
    "order_max": 999
  },
  "doc": {
    "description": "文档命名规则：NNN-EnglishName.md（如 001-GettingStarted.md，PascalCase）",
    "pattern": "^(\\d{3})-([A-Za-z][A-Za-z0-9-]*)\\.md$",
    "groups": {
      "order": 1,
      "english_name": 2
    },
    "order_min": 1,
    "order_max": 999
  },
  "english_short_pattern": {
    "description": "模块英文简称校验（小写字母开头，允许字母数字与连字符）",
    "pattern": "^[a-z][a-z0-9-]*$"
  },
  "english_name_pattern": {
    "description": "文档英文名校验（字母开头，允许字母数字与连字符，PascalCase 推荐）",
    "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
  }
}
