{
  "version": "2.0.0",
  "module": "mongodb",
  "summary": "从快速上手到生产精通：CRUD、聚合与索引打底，再进入事务、副本集分片、安全与实时应用。",
  "stages": [
    {
      "id": "basics",
      "title": "入门与增删改查",
      "subtitle": "五分钟上手与完整 CRUD",
      "nodes": [
        {
          "id": "mongo-001",
          "title": "MongoDB 概述与快速上手",
          "desc": "认识文档数据库并跑通第一条命令",
          "difficulty": "beginner",
          "doc": "001-MongoDBOverviewQuickStart"
        },
        {
          "id": "mongo-002",
          "title": "增删改查完整语法",
          "desc": "insert/find/update/delete 全形态",
          "difficulty": "beginner",
          "doc": "002-CRUDOperations"
        }
      ]
    },
    {
      "id": "pipeline-index",
      "title": "聚合与索引",
      "subtitle": "查询能力与性能地基",
      "nodes": [
        {
          "id": "mongo-101",
          "title": "聚合管道",
          "desc": "阶段化数据加工：match/group/lookup",
          "difficulty": "intermediate",
          "doc": "003-AggregationPipeline"
        },
        {
          "id": "mongo-102",
          "title": "索引与查询性能",
          "desc": "索引类型、执行计划与慢查询",
          "difficulty": "intermediate",
          "doc": "004-IndexPerformance"
        }
      ]
    },
    {
      "id": "enterprise",
      "title": "企业级进阶",
      "subtitle": "建模、事务、架构、安全与实时",
      "nodes": [
        {
          "id": "mongo-201",
          "title": "数据建模与企业落地",
          "desc": "嵌入 vs 引用与反范式实践",
          "difficulty": "intermediate",
          "doc": "005-SchemaDesignEnterprise"
        },
        {
          "id": "mongo-202",
          "title": "事务与会话",
          "desc": "多文档事务与因果一致性",
          "difficulty": "intermediate",
          "doc": "006-TransactionSession"
        },
        {
          "id": "mongo-203",
          "title": "副本集与分片架构",
          "desc": "oplog、选举与 shard key 选型",
          "difficulty": "advanced",
          "doc": "007-ReplicaSetSharding"
        },
        {
          "id": "mongo-204",
          "title": "安全与用户管理",
          "desc": "认证授权与最小权限",
          "difficulty": "intermediate",
          "doc": "008-SecurityUserManagement"
        },
        {
          "id": "mongo-205",
          "title": "变更流与实时应用",
          "desc": "Change Streams 与断点续听",
          "difficulty": "advanced",
          "doc": "009-ChangeStreamRealtime"
        }
      ]
    }
  ]
}
